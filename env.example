# Copy to .env.local (preferred) or .env
#
#   cp env.example .env.local
#
# Then run:
#   npm install
#   npm start

PORT=8080
JWT_SECRET=replace-me-with-a-long-random-string

# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/farm_to_door
#
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_URI=

# Optional: seed products on startup (WARNING: overwrites products)
SEED_PRODUCTS=false


